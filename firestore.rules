rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isSignedIn() { return request.auth != null; }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() { 
      return isSignedIn() && (
        ("email" in request.auth.token && request.auth.token.email == "madrasabarvia@gmail.com") ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == "admin")
      );
    }
    
    function isStudent() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == "student";
    }

    function isTeacher() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == "teacher";
    }
    
    // Helper to get student document ID for the current logged-in user
    function getMyStudentId() {
      return getUserData().studentId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      // Users can read their own role. Admin can read all.
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && (request.resource.data.role == 'unverified' || ("email" in request.auth.token && request.auth.token.email == "madrasabarvia@gmail.com"));
      allow update, delete: if isAdmin();
    }

    match /students/{studentDocId} {
      allow read: if isAdmin() || (isStudent() && resource.data.studentId == getMyStudentId()) || (isTeacher() && resource.data.teacherId == request.auth.uid) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'pending');
      allow update: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if isAdmin() || (isStudent() && resource.data.studentId == getMyStudentId()) || (isTeacher() && get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.teacherId == request.auth.uid);
      allow create, update: if isAdmin() || (isTeacher() && get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.teacherId == request.auth.uid);
      allow delete: if isAdmin() || (isTeacher() && get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.teacherId == request.auth.uid);
    }

    match /daily_reports/{reportId} {
      allow read: if isAdmin() || (isStudent() && resource.data.studentId == getMyStudentId()) || (isTeacher() && get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.teacherId == request.auth.uid);
      allow create, update: if isAdmin() || (isTeacher() && get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.teacherId == request.auth.uid);
      allow delete: if isAdmin() || (isTeacher() && get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.teacherId == request.auth.uid);
    }

    match /income/{incomeId} {
      allow read, write: if isAdmin();
    }

    match /expenses/{expenseId} {
      allow read, write: if isAdmin();
    }
  }
}

